    "render:preview": "tsx scripts/render-preview.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
