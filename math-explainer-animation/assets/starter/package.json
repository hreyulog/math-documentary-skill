{
  "name": "math-animation-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frame-driven SVG mathematics animation starter; first 15 seconds only",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit && tsx scripts/check-math.ts",
